  "item": [
    {
      "name": "New Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var template = `\r",
              "<style>\r",
              "    #map {\r",
              "        height: 400px;\r",
              "        width: 100%;\r",
              "    }\r",
              "</style>\r",
              "\r",
              "<div>\r",
              "    <label for=\"filter\">Filter by Access Point Type:</label>\r",
              "    <select id=\"filter\">\r",
              "        <option value=\"all\">All Locations</option>\r",
              "        <option value=\"ODIN_LOCKER\">ODIN LOCKER</option>\r",
              "    </select>\r",
              "</div>\r",
              "<div id=\"map\"></div>\r",
              "\r",
              "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.js\"></script>\r",
              "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.css\" />\r",
              "\r",
              "<script>\r",
              "    var map = L.map('map').setView([51.2795, -2.105], 10); // Center the map on the provided coordinates\r",
              "\r",
              "    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\r",
              "        maxZoom: 19,\r",
              "        attribution: '© OpenStreetMap'\r",
              "    }).addTo(map);\r",
              "\r",
              "    function updateMap(locations) {\r",
              "        // Clear existing markers\r",
              "        map.eachLayer(function (layer) {\r",
              "            if (layer instanceof L.Marker) {\r",
              "                map.removeLayer(layer);\r",
              "            }\r",
              "        });\r",
              "\r",
              "        locations.forEach(function(location) {\r",
              "            if (location.location && location.location.latitude && location.location.longitude) {\r",
              "                L.marker([location.location.latitude, location.location.longitude]).addTo(map)\r",
              "                    .bindPopup(location.name || 'Locker Location')\r",
              "                    .openPopup();\r",
              "            }\r",
              "        });\r",
              "    }\r",
              "\r",
              "    pm.getData(function (err, value) {\r",
              "        var locations = value.response.locationList; // Show all locker locations\r",
              "        updateMap(locations); // Initial map update\r",
              "\r",
              "        // Filter locations based on selection\r",
              "        document.getElementById('filter').addEventListener('change', function() {\r",
              "            var selectedType = this.value;\r",
              "            var filteredLocations = selectedType === 'ODIN_LOCKER' ? \r",
              "                locations.filter(location => location.apisAccessPointType === selectedType) : \r",
              "                locations;\r",
              "            updateMap(filteredLocations);\r",
              "        });\r",
              "    });\r",
              "</script>\r",
              "`;\r",
              "\r",
              "function constructVisualizerPayload() {\r",
              "    var res = pm.response.json();\r",
              "    return { response: res };\r",
              "}\r",
              "\r",
              "pm.visualizer.set(template, constructVisualizerPayload());"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Set default search coordinates if not already defined",
              "// Change these variables in your environment or collection variables to search a different area",
              "",
              "if (!pm.variables.get(\"latitude\")) {",
              "    pm.variables.set(\"latitude\", \"54.9770215543416\");",
              "}",
              "",
              "if (!pm.variables.get(\"longitude\")) {",
              "    pm.variables.set(\"longitude\", \"-1.5981993984361398\");",
              "}",
              "",
              "// Tip: To search a new location, set these in your environment:",
              "//   latitude  = e.g. 51.5074  (London)",
              "//   longitude = e.g. -0.1278"
            ]
          }
        }
      ],
